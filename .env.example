# Copy this file to .env.local and fill in what you have.
# The app runs without any of these: drafts fall back to built-in demo drafts.

# --- AI drafts (Claude API) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Coach identity ---
COACH_NAME=Alex
# Your own email. Forwarded emails from this address are unwrapped to find the real client.
COACH_EMAIL=

# --- Email forwarding (inbound webhook) ---
# Point your inbound email provider (Postmark, SendGrid Inbound Parse, Cloudflare Email Workers...)
# at:  https://YOUR-APP/api/intake/email?token=INBOUND_EMAIL_TOKEN
INBOUND_EMAIL_TOKEN=
INBOUND_EMAIL_DOMAIN=in.gainstalk.com

# --- WhatsApp Business Platform (Coexistence) ---
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
META_GRAPH_VERSION=v25.0
# Used to check that webhooks really come from Meta (X-Hub-Signature-256)
META_APP_SECRET=

# --- Instagram Messaging ---
# Webhook: https://YOUR-APP/api/webhooks/instagram
INSTAGRAM_VERIFY_TOKEN=
# Instagram user access token (Instagram API with Instagram Login). Lets replies send from the app.
INSTAGRAM_TOKEN=

# --- Facebook Messenger ---
# Webhook: https://YOUR-APP/api/webhooks/messenger
MESSENGER_VERIFY_TOKEN=
# Page access token for your Facebook Page. Lets replies send from the app.
MESSENGER_PAGE_TOKEN=

# Optional: one verify token for all Meta webhooks instead of separate ones
META_VERIFY_TOKEN=

# --- Intake link for Zapier, Make and iPhone Shortcuts (Trainerize, texts) ---
# POST JSON {"channel","from","name","text"} to https://YOUR-APP/api/intake/webhook?token=INTAKE_TOKEN
INTAKE_TOKEN=

# Where the JSON data store and uploads live
DATA_DIR=./data

# Email shown on the privacy policy, terms and data deletion pages
CONTACT_EMAIL=privacy@gainstalk.com

# --- WhatsApp through Twilio (Sandbox for testing, or a Twilio WhatsApp sender) ---
# When these are set, WhatsApp replies go out through Twilio.
# Twilio Console > Try WhatsApp > Sandbox settings > "When a message comes in":
#   https://YOUR-APP/api/webhooks/twilio  (POST)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=+14155238886
# Public address of the app, used for Twilio delivery updates
APP_URL=https://www.gainstalk.com
